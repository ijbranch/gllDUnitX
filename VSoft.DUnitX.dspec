# DPM package spec file
min dpm client version: 1.0.0
metadata:
  id: GITLAK.DUnitX
  version: 0.5.1
  description: GITLAK fork of DUnitX, baselined on VSoft.DUnitX 0.5.1 and scoped to Delphi 13 (Florence), 64 bit Windows only
  authors:
    - Vincent Parrett
    - GITLAK Software
  projectUrl: https://github.com/ijbranch/gllDUnitX
  repositoryUrl: https://github.com/ijbranch/gllDUnitX
  repositoryCommit: #HASH#
  license: Apache-2.0
  copyright: Vincent Parrett and contributors
  tags:
    - unit testing
    - dunitx
    - dunit
  readme: README.md
variables:
  packagesource: Rad Studio $compilernoprefix$
targetPlatforms:
  - compiler: delphi13.0
    platforms:
      - win64
templates:
  - name: default
    source:
      - src: ./LICENSE.txt
      - src: ./source/*.pas
      - src: ./source/*.inc
      - src: ./source/*.dfm
      - src: ./packages/$packageSource$/*.dpk
      - src: ./packages/$packageSource$/*.dproj
    build:
      - project: ./packages/$packageSource$/VSoft.DUnitXWinR.dproj
